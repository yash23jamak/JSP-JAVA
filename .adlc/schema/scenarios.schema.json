{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adlc-knowledge-scenarios-v1",
  "title": "ADLC example tickets (.adlc/knowledge/scenarios.json)",
  "description": "Ready-made tickets offered on 'Log a ticket', used to demonstrate and test the pack.",
  "oneOf": [
    { "type": "array", "items": { "$ref": "#/$defs/scenario" } },
    {
      "type": "object",
      "required": ["entries"],
      "additionalProperties": false,
      "properties": { "$schema": { "type": "string" }, "entries": { "type": "array", "items": { "$ref": "#/$defs/scenario" } } }
    }
  ],
  "$defs": {
    "scenario": {
      "type": "object",
      "required": ["id", "label", "ticket"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{2,60}$", "examples": ["discount-defect"] },
        "label": { "type": "string", "examples": ["Defect: 10% discount subtracted as 10"] },
        "expected": { "type": "string", "description": "What should happen, e.g. which playbook or rule it matches" },
        "ticket": {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": { "type": "string", "minLength": 5, "maxLength": 200, "description": "In the user's words. Change requests need a verb such as change, set, increase." },
            "description": { "type": "string" },
            "service": { "type": "string" },
            "impact": { "enum": ["low", "medium", "high", "critical"] }
          }
        },
        "draft": { "type": "boolean" },
        "source": { "type": "string" },
        "review": { "type": "string" }
      }
    }
  }
}
