{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adlc-knowledge-playbooks-v1",
  "title": "ADLC fix playbooks (.adlc/knowledge/playbooks.json)",
  "description": "Known defects with an approved fix. When a ticket matches the keywords or symptoms, the platform writes the regression test (must fail = red), applies the patches (test must pass = green), runs the suite and opens a pull request.",
  "oneOf": [
    { "type": "array", "items": { "$ref": "#/$defs/playbook" } },
    {
      "type": "object",
      "required": ["entries"],
      "additionalProperties": false,
      "properties": { "$schema": { "type": "string" }, "entries": { "type": "array", "items": { "$ref": "#/$defs/playbook" } } }
    }
  ],
  "$defs": {
    "playbook": {
      "type": "object",
      "required": ["id", "slug", "title", "keywords", "patches"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,59}$", "examples": ["FX-DISCOUNT"] },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]{2,60}$", "description": "Branch name part", "examples": ["percent-discount"] },
        "title": { "type": "string", "description": "May use rule variables, e.g. {{BL_02}}", "examples": ["Percentage discount subtracted as an amount"] },
        "component": { "type": "string", "examples": ["invoice"] },
        "service": { "type": "string", "description": "One of app.json services (ties go to the matching service)" },
        "spec": { "type": "string", "description": "Rule/spec id the fix restores", "examples": ["BL-01"] },
        "knowledgeArticle": { "type": "string" },
        "risk": { "enum": ["standard", "normal", "high"], "description": "standard = may release without a release approval when gates are green" },
        "classification": { "type": "string", "examples": ["bug-fix"] },
        "keywords": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Words or phrases users write (lower case). Matching is on the ticket title, description and evidence.", "examples": [["discount", "percent", "10%"]] },
        "symptoms": { "type": "array", "items": { "type": "string" }, "examples": [["discount is wrong", "total too high"]] },
        "uses": { "type": "array", "items": { "type": "string" }, "description": "Rule ids whose current value the texts or patches use ({{RULE_VAR}})" },
        "probableCause": { "type": "string", "description": "Shown as the root cause", "examples": ["applyDiscount() in src/invoice.js subtracts the percentage as an amount."] },
        "commitScope": { "type": "string" },
        "commitSubject": { "type": "string" },
        "patches": {
          "type": "array",
          "description": "Exact edits. find must occur once in the file; or pattern (regex) with replace (may use $1).",
          "items": {
            "type": "object",
            "required": ["file", "replace"],
            "properties": {
              "file": { "type": "string" },
              "find": { "type": "string" },
              "pattern": { "type": "string" },
              "replace": { "type": "string" }
            },
            "oneOf": [{ "required": ["find"] }, { "required": ["pattern"] }]
          }
        },
        "regressionTest": { "type": "string", "description": "Template path relative to .adlc/knowledge/; variables {{ticketId}}, {{title}}, {{spec}} and rule vars", "examples": ["templates/FX-DISCOUNT.test.js.tmpl"] },
        "draft": { "type": "boolean" },
        "source": { "type": "string" },
        "review": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" }, "description": "Informational: files involved" }
      }
    }
  }
}
