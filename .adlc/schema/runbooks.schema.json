{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adlc-knowledge-runbooks-v1",
  "title": "ADLC runbooks (.adlc/knowledge/runbooks.json)",
  "description": "Approved operational fixes for known errors (restart a worker, clear a queue). Only runbooks with approved: true run, and only in linked environments.",
  "oneOf": [
    { "type": "array", "items": { "$ref": "#/$defs/runbook" } },
    {
      "type": "object",
      "required": ["entries"],
      "additionalProperties": false,
      "properties": { "$schema": { "type": "string" }, "entries": { "type": "array", "items": { "$ref": "#/$defs/runbook" } } }
    }
  ],
  "$defs": {
    "runbook": {
      "type": "object",
      "required": ["id", "title", "owner", "approved", "env", "command", "keywords"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,59}$", "examples": ["RB-01"] },
        "title": { "type": "string", "examples": ["Restart the invoice worker"] },
        "owner": { "type": "string", "description": "Team accountable for the runbook", "examples": ["Billing SRE"] },
        "approved": { "type": "boolean", "description": "Only approved runbooks run automatically" },
        "risk": { "enum": ["low", "medium", "high"] },
        "env": { "type": "string", "description": "Environment it acts on (registered environment name)", "examples": ["prod"] },
        "command": {
          "type": "string",
          "description": "Run in the deployed release with action = precheck | execute | postcheck | revert. {state} = ops-state file, {action} = the action. The LAST stdout line must be JSON {\"ok\": bool, \"message\": string}. precheck ok=true means the known error is present.",
          "examples": ["node ops/runbooks/restart-worker.js {state} {action}"]
        },
        "knowledgeArticle": { "type": "string" },
        "service": { "type": "string" },
        "monitor": { "type": "string", "description": "Manifest monitor id that detects this error (an unhealthy monitor routes matching tickets here)" },
        "keywords": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "symptoms": { "type": "array", "items": { "type": "string" } },
        "probableCause": { "type": "string" },
        "draft": { "type": "boolean" },
        "source": { "type": "string" },
        "review": { "type": "string" }
      }
    }
  }
}
